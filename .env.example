# Copy to an untracked environment file or export these in the shell.
# Do not put a provider key, payment secret, or a real Better Auth secret in this file.

# Generate a random string of at least 32 characters locally. Do not commit it.
BETTER_AUTH_SECRET=

DATABASE_PATH=./data/app.sqlite
DATA_DIR=./data
HOST=127.0.0.1
PORT=8787
SESSION_TTL_HOURS=336
COOKIE_SECURE=false

# live talks to the provider. fixture is refused unless ALLOW_GATEWAY_FIXTURE=1
# and is refused entirely when NODE_ENV=production.
MODEL_GATEWAY_MODE=live
# 88API trial base. The gateway appends /chat/completions. Do not write /v1/v1.
DEEPSEEK_BASE_URL=https://api.88api.ai/v1
# DEEPSEEK_API_KEY=sk-replace-with-your-88api-token
# Server-side model. Leave empty to send the model selected in the client.
DEEPSEEK_MODEL=deepseek-v4.1-flash
# low, high, or max omits temperature. none sends TEMPERATURE and disables thinking.
REASONING_EFFORT=low
# Used only when REASONING_EFFORT=none. Highest documented value is 2. Not sent together with thinking.
TEMPERATURE=2

# Optional integer prices. CNY values are fen per million tokens.
# USD values are micro-USD per million tokens and are not converted to CNY
# unless FX_CNY_FEN_PER_USD, FX_SOURCE, and FX_QUOTED_AT are all set.
# MODEL_PRICE_CURRENCY=CNY
# MARGIN_BPS=3000
# BILLING_RESERVE_FEN=0
# MODEL_PRICE_JSON={"deepseek-flash":{"input_per_million":70,"output_per_million":70}}

# Mail and payment stay closed unless a fixture is explicitly enabled.
# Both fixtures are refused when NODE_ENV=production.
# MAIL_TRANSPORT=unconfigured
# ALLOW_MAIL_FIXTURE=0
# ALLOW_TEST_PAYMENTS=0

# In-process initiative scheduler. 0 disables the timer; POST /api/initiative/tick still works.
INITIATIVE_POLL_MS=0

# First administrator is created only by the CLI:
# ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='a-long-password' npm run admin:init
