# Copy to an untracked environment file or export these in the shell.
# Do not put a provider key in this file. There is no sample key.

DATABASE_PATH=./data/app.sqlite
# Production refuses to start unless this is a postgres connection string.
# Leave it unset for the local SQLite trial. Never commit a real URL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB
DATA_DIR=./data
HOST=127.0.0.1
PORT=8787
SESSION_TTL_HOURS=336
# Leave false for the local HTTP trial. Set true only when the browser origin is HTTPS.
COOKIE_SECURE=false
# Serves the built pages and the API on the same origin. A static host cannot replace this.
# STATIC_DIR=./web/dist

# live talks to the provider. fixture is refused unless ALLOW_GATEWAY_FIXTURE=1
# and is refused entirely when NODE_ENV=production.
MODEL_GATEWAY_MODE=live
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=

# Optional configured unit prices. Missing prices stay unknown. Do not invent a token price.
# MODEL_PRICE_JSON={"deepseek-flash":{"input_per_million":0,"output_per_million":0}}
# BILLING_ENABLED stays unset so the trial chat does not deduct a balance.
# Set it to 1 only together with MODEL_PRICE_CURRENCY and a real price you verified.
# CNY prices are integer fen per million tokens. USD also needs FX_CNY_FEN_PER_USD, FX_SOURCE, and FX_QUOTED_AT.
# MARGIN_BPS defaults to 3000: UserCharge = C / (1 - 0.30), not C * 1.3.
# BILLING_ENABLED=
# MODEL_PRICE_CURRENCY=
# MARGIN_BPS=3000
# BILLING_RESERVE_FEN=0
# FX_CNY_FEN_PER_USD=
# FX_SOURCE=
# FX_QUOTED_AT=

# Memory retrieval. off is lexical overlap only. DeepSeek's chat API has no embeddings endpoint;
# do not point EMBEDDING_BASE_URL at api.deepseek.com.
# local loads BAAI/bge-small-zh-v1.5 (MIT, int8 ONNX, 512 dimensions) in this process.
# A measured local load used about 80MB of extra RSS. Leave this off on a 512MB host unless you accept that.
# http needs EMBEDDING_BASE_URL, EMBEDDING_API_KEY, and EMBEDDING_MODEL together.
# EMBEDDING_MIN_COSINE defaults to 0.44 because that separated “长期偏好绿茶” from other drinks
# on this local model. Retune it for any other embedding model.
# EMBEDDING_MODE=off
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_TIMEOUT_MS=2500
# EMBEDDING_MIN_COSINE=0.44

# In-process initiative scheduler. 0 disables the timer; POST /api/initiative/tick still works.
# Production refuses any value above 0 because a free host sleeps.
INITIATIVE_POLL_MS=0

# First administrator. Do not commit real values.
# On startup, both variables together create the admin only when none exists.
# A later start does not change that password. Unset them after the first success if you do not want them stored.
# Password length is 12-200 characters. There is no default password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# A machine with a shell can still run: ADMIN_EMAIL=... ADMIN_PASSWORD=... npm run admin:init
# Invite codes are created after that admin logs in, from the admin page. They are not printed in logs.
