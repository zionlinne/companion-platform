# Copy to an untracked environment file or export these in the shell.
# Do not put a provider key in this file. There is no sample key.

DATABASE_PATH=./data/app.sqlite
# Production refuses to start unless this is a postgres connection string.
# Leave it unset for the local SQLite trial. Never commit a real URL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB
DATA_DIR=./data
HOST=127.0.0.1
PORT=8787
SESSION_TTL_HOURS=336
# Leave false for the local HTTP trial. Set true only when the browser origin is HTTPS.
COOKIE_SECURE=false
# Serves the built pages and the API on the same origin. A static host cannot replace this.
# STATIC_DIR=./web/dist

# live talks to the provider. fixture is refused unless ALLOW_GATEWAY_FIXTURE=1
# and is refused entirely when NODE_ENV=production.
MODEL_GATEWAY_MODE=live
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=

# Optional configured unit prices in USD per million tokens.
# Missing prices are reported as unknown, not as an invoice.
# MODEL_PRICE_JSON={"deepseek-flash":{"input_per_million":0,"output_per_million":0}}

# In-process initiative scheduler. 0 disables the timer; POST /api/initiative/tick still works.
# Production refuses any value above 0 because a free host sleeps.
INITIATIVE_POLL_MS=0

# First administrator is created only by the CLI:
# ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='a-long-password' npm run admin:init
