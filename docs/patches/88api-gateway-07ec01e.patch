diff --git a/server/src/upstream-request.ts b/server/src/upstream-request.ts
new file mode 100644
index 0000000..e31c5ec
--- /dev/null
+++ b/server/src/upstream-request.ts
@@ -0,0 +1,125 @@
+export const REASONING_EFFORTS = ['low', 'high', 'max', 'none'] as const
+
+export type ReasoningEffort = (typeof REASONING_EFFORTS)[number]
+
+export type UpstreamSettings = {
+  baseUrl: string
+  model: string | null
+  reasoningEffort: ReasoningEffort
+  temperature: number
+}
+
+const MODEL_ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/
+
+export function readUpstreamSettings(
+  env: NodeJS.ProcessEnv,
+  overrides: {
+    baseUrl?: string
+    model?: string | null
+    reasoningEffort?: ReasoningEffort
+    temperature?: number
+  } = {}
+): UpstreamSettings {
+  const baseUrl = normalizeBaseUrl(overrides.baseUrl ?? env.DEEPSEEK_BASE_URL ?? 'https://api.deepseek.com')
+  const model = normalizeModel(overrides.model === undefined ? env.DEEPSEEK_MODEL : overrides.model ?? undefined)
+  const reasoningEffort = normalizeReasoning(overrides.reasoningEffort ?? env.REASONING_EFFORT)
+  const temperature = normalizeTemperature(overrides.temperature ?? env.TEMPERATURE)
+  return { baseUrl, model, reasoningEffort, temperature }
+}
+
+export function normalizeBaseUrl(raw: string): string {
+  const trimmed = raw.trim().replace(/\/+$/, '')
+  if (!trimmed) throw new Error('DEEPSEEK_BASE_URL is empty')
+  let url: URL
+  try {
+    url = new URL(trimmed)
+  } catch {
+    throw new Error('DEEPSEEK_BASE_URL must be an absolute http(s) URL')
+  }
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+    throw new Error('DEEPSEEK_BASE_URL must use http or https')
+  }
+  if (url.username || url.password) throw new Error('DEEPSEEK_BASE_URL must not contain credentials')
+  if (url.search || url.hash) throw new Error('DEEPSEEK_BASE_URL must not contain a query or hash')
+  const path = url.pathname.replace(/\/+$/, '')
+  if (/\/v1\/v1(\/|$)/i.test(path)) {
+    throw new Error('DEEPSEEK_BASE_URL contains /v1/v1. For 88API use https://api.88api.ai/v1 and do not append /chat/completions yourself.')
+  }
+  if (url.hostname === 'api.88api.ai' && path !== '/v1' && path !== '/v1/chat/completions') {
+    throw new Error('88API DEEPSEEK_BASE_URL must be https://api.88api.ai/v1. Omitting /v1 or adding another /v1 is rejected.')
+  }
+  return `${url.origin}${path}`
+}
+
+export function chatCompletionsUrl(baseUrl: string): string {
+  const normalized = normalizeBaseUrl(baseUrl)
+  if (normalized.endsWith('/chat/completions')) return normalized
+  return `${normalized}/chat/completions`
+}
+
+export function buildLiveChatBody(
+  settings: UpstreamSettings,
+  input: { model: string; messages: unknown[] }
+): { url: string; body: Record<string, unknown>; temperatureSent: boolean; sampling: 'thinking-temperature-omitted' | 'non-thinking-temperature-sent' } {
+  const model = settings.model ?? input.model
+  if (!MODEL_ID.test(model)) throw new Error('Upstream model id is not a single token of letters, numbers, dots, or hyphens')
+  const body: Record<string, unknown> = {
+    model,
+    messages: input.messages,
+    stream: true,
+    stream_options: { include_usage: true },
+    reasoning_effort: settings.reasoningEffort,
+  }
+  const thinking = settings.reasoningEffort !== 'none'
+  if (!thinking) body.temperature = settings.temperature
+  return {
+    url: chatCompletionsUrl(settings.baseUrl),
+    body,
+    temperatureSent: !thinking,
+    sampling: thinking ? 'thinking-temperature-omitted' : 'non-thinking-temperature-sent',
+  }
+}
+
+export function describeUpstream(settings: UpstreamSettings) {
+  const built = buildLiveChatBody(settings, { model: settings.model ?? 'deepseek-flash', messages: [] })
+  return {
+    chatCompletionsUrl: built.url,
+    model: settings.model,
+    reasoningEffort: settings.reasoningEffort,
+    temperatureConfigured: settings.temperature,
+    temperatureSent: built.temperatureSent,
+    sampling: built.sampling,
+    note:
+      built.sampling === 'thinking-temperature-omitted'
+        ? 'reasoning_effort low、high、max 按 DeepSeek 官方说明属于思考模式。这次 live 请求不发送 temperature，不能把温度和思考档说成同时生效。88API 令牌是否允许 deepseek-v4.1-flash 尚未验证。'
+        : 'reasoning_effort=none 才发送 temperature。这是非思考请求的采样参数，不是和思考档一起生效。',
+  }
+}
+
+function normalizeModel(raw: string | null | undefined): string | null {
+  if (raw === undefined || raw === null) return null
+  const model = raw.trim()
+  if (!model) return null
+  if (!MODEL_ID.test(model)) throw new Error('DEEPSEEK_MODEL must be one token of letters, numbers, dots, or hyphens')
+  return model
+}
+
+function normalizeReasoning(raw: string | ReasoningEffort | undefined): ReasoningEffort {
+  const value = (raw ?? 'low').trim()
+  if (value === 'medium') {
+    throw new Error('REASONING_EFFORT=medium is only the generic 88API o-series example. DeepSeek uses none, low, high, or max. medium is rejected so it is not silently mapped.')
+  }
+  if (!REASONING_EFFORTS.includes(value as ReasoningEffort)) {
+    throw new Error('REASONING_EFFORT must be low, high, max, or none')
+  }
+  return value as ReasoningEffort
+}
+
+function normalizeTemperature(raw: number | string | undefined): number {
+  if (raw === undefined || raw === '') return 2
+  const value = typeof raw === 'number' ? raw : Number(raw)
+  if (!Number.isFinite(value) || value < 0 || value > 2) {
+    throw new Error('TEMPERATURE must be a number from 0 to 2')
+  }
+  return value
+}
diff --git a/server/test/upstream-request.test.ts b/server/test/upstream-request.test.ts
new file mode 100644
index 0000000..497b9a3
--- /dev/null
+++ b/server/test/upstream-request.test.ts
@@ -0,0 +1,146 @@
+import assert from 'node:assert/strict'
+import { createServer } from 'node:http'
+import test from 'node:test'
+import { loadConfig } from '../src/config.ts'
+import { GatewayError, streamCompletion } from '../src/gateway.ts'
+import { buildLiveChatBody, chatCompletionsUrl, readUpstreamSettings } from '../src/upstream-request.ts'
+
+test('88API live body uses reasoning_effort low and omits temperature', () => {
+  const settings = readUpstreamSettings({
+    DEEPSEEK_BASE_URL: 'https://api.88api.ai/v1/',
+    DEEPSEEK_MODEL: 'deepseek-v4.1-flash',
+    REASONING_EFFORT: 'low',
+    TEMPERATURE: '2',
+  })
+  const built = buildLiveChatBody(settings, {
+    model: 'deepseek-flash',
+    messages: [{ role: 'user', content: '你好' }],
+  })
+  assert.equal(built.url, 'https://api.88api.ai/v1/chat/completions')
+  assert.equal(built.url.includes('/v1/v1'), false)
+  assert.equal(built.body.model, 'deepseek-v4.1-flash')
+  assert.equal(built.body.reasoning_effort, 'low')
+  assert.equal(built.body.stream, true)
+  assert.equal(Object.hasOwn(built.body, 'temperature'), false)
+  assert.equal(Object.hasOwn(built.body, 'thinking'), false)
+  assert.equal(built.temperatureSent, false)
+  assert.equal(built.sampling, 'thinking-temperature-omitted')
+})
+
+test('temperature is sent only when reasoning_effort is none', () => {
+  const settings = readUpstreamSettings({
+    DEEPSEEK_BASE_URL: 'https://api.88api.ai/v1',
+    REASONING_EFFORT: 'none',
+    TEMPERATURE: '2',
+  })
+  const built = buildLiveChatBody(settings, { model: 'deepseek-v4.1-flash', messages: [] })
+  assert.equal(built.body.reasoning_effort, 'none')
+  assert.equal(built.body.temperature, 2)
+  assert.equal(built.temperatureSent, true)
+  assert.equal(built.sampling, 'non-thinking-temperature-sent')
+})
+
+test('base URL rejects a second /v1 and a bare 88API host', () => {
+  assert.throws(() => chatCompletionsUrl('https://api.88api.ai/v1/v1'), /v1\/v1/)
+  assert.throws(() => chatCompletionsUrl('https://api.88api.ai'), /must be https:\/\/api\.88api\.ai\/v1/)
+  assert.equal(chatCompletionsUrl('https://api.88api.ai/v1/chat/completions'), 'https://api.88api.ai/v1/chat/completions')
+  assert.throws(() => readUpstreamSettings({ REASONING_EFFORT: 'medium' }), /medium/)
+  assert.throws(() => readUpstreamSettings({ TEMPERATURE: '3' }), /TEMPERATURE/)
+  assert.throws(() => readUpstreamSettings({ DEEPSEEK_MODEL: 'bad model' }), /DEEPSEEK_MODEL/)
+})
+
+test('live stream posts the 88API body and does not label the recorder as a fixture', async () => {
+  const seen: Array<{ url: string | undefined; authorization: string | undefined; body: unknown }> = []
+  const server = createServer(async (req, res) => {
+    const chunks: Buffer[] = []
+    for await (const chunk of req) chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))
+    seen.push({
+      url: req.url,
+      authorization: typeof req.headers.authorization === 'string' ? req.headers.authorization : undefined,
+      body: JSON.parse(Buffer.concat(chunks).toString('utf8')),
+    })
+    res.writeHead(200, { 'Content-Type': 'text/event-stream' })
+    res.end('data: {"choices":[{"delta":{"content":"local"}}]}\n\ndata: {"usage":{"prompt_tokens":2,"completion_tokens":1}}\n\ndata: [DONE]\n\n')
+  })
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', () => resolve()))
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('recorder failed')
+  const key = 'sk-local-recorder-not-a-provider'
+  try {
+    const config = loadConfig(
+      { NODE_ENV: 'test' },
+      {
+        nodeEnv: 'test',
+        gatewayMode: 'live',
+        deepseekApiKey: key,
+        deepseekBaseUrl: `http://127.0.0.1:${address.port}`,
+        deepseekModel: 'deepseek-v4.1-flash',
+        reasoningEffort: 'low',
+        temperature: 2,
+      }
+    )
+    let text = ''
+    const result = await streamCompletion(config, {
+      model: 'deepseek-flash',
+      messages: [{ role: 'user', content: '你好' }],
+      thinking: true,
+      onDelta: (delta) => {
+        text += delta.content ?? ''
+      },
+    })
+    assert.equal(result.source, 'live')
+    assert.equal(text, 'local')
+    assert.equal(seen.length, 1)
+    assert.equal(seen[0]?.url, '/chat/completions')
+    assert.equal(seen[0]?.authorization, `Bearer ${key}`)
+    const body = seen[0]?.body as Record<string, unknown>
+    assert.equal(body.model, 'deepseek-v4.1-flash')
+    assert.equal(body.reasoning_effort, 'low')
+    assert.equal(Object.hasOwn(body, 'temperature'), false)
+    assert.equal(JSON.stringify(seen).includes('fixture-reply'), false)
+  } finally {
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
+
+test('live mode without a key fails before any provider request', async () => {
+  let calls = 0
+  const server = createServer((_req, res) => {
+    calls += 1
+    res.writeHead(200)
+    res.end('fixture-reply:should-not-be-read')
+  })
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', () => resolve()))
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('recorder failed')
+  try {
+    const config = loadConfig(
+      { NODE_ENV: 'test', DEEPSEEK_API_KEY: '' },
+      {
+        nodeEnv: 'test',
+        gatewayMode: 'live',
+        deepseekApiKey: null,
+        deepseekBaseUrl: `http://127.0.0.1:${address.port}`,
+      }
+    )
+    await assert.rejects(
+      () =>
+        streamCompletion(config, {
+          model: 'deepseek-flash',
+          messages: [{ role: 'user', content: '你好' }],
+          thinking: false,
+          onDelta: () => undefined,
+        }),
+      (error: unknown) => {
+        assert.ok(error instanceof GatewayError)
+        assert.equal(error.code, 'model_gateway_unconfigured')
+        assert.equal(error.message.includes('fixture-reply'), false)
+        assert.equal(error.message.includes('sk-'), false)
+        return true
+      }
+    )
+    assert.equal(calls, 0)
+  } finally {
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
